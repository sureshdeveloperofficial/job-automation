# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://career_os:career_os_password@localhost:5432/career_os_db?schema=public"

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── S3 / MinIO (local) ────────────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="career-os-files"
S3_ACCESS_KEY="career_os_minio"
S3_SECRET_KEY="career_os_minio_secret"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-very-long-random-secret-at-least-64-chars"
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY_DAYS="7"

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Options: none | ollama | gemini | openai
AI_PROVIDER="none"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT="1961"
API_HOST="0.0.0.0"
WEB_URL="http://localhost:1962"
API_URL="http://localhost:1961"

# ─── Observability ─────────────────────────────────────────────────────────────
OTEL_ENDPOINT=""
SENTRY_DSN=""
LOG_LEVEL="debug"

# ─── Email (Phase 2) ───────────────────────────────────────────────────────────
# Set to "console" in development to log emails instead of sending
EMAIL_TRANSPORT="console"
EMAIL_FROM="noreply@career-os.local"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL="60000"
THROTTLE_LIMIT="100"

