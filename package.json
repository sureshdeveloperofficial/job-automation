{
  "name": "ai-career-os",
  "private": true,
  "version": "0.1.0",
  "description": "AI Career OS — End-to-end career intelligence and job automation platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml}\" --ignore-path .gitignore",
    "db:migrate": "pnpm -F api run prisma:migrate",
    "db:generate": "pnpm -F api run prisma:generate",
    "db:studio": "pnpm -F api run prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
